{
  "name": "smart-theme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/audit-trusted-runtime.mjs && node scripts/audit-app-surfaces.mjs && vite build",
    "preview": "vite preview",
    "audit:apps": "node scripts/audit-app-surfaces.mjs",
    "audit:trusted": "node scripts/audit-trusted-runtime.mjs",
    "audit:workflow-coverage": "node scripts/audit-workflow-coverage.mjs",
    "audit:workflow-coverage:enforce": "node scripts/audit-workflow-coverage.mjs --enforce",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.7",
    "@playwright/test": "^1.56.0"
  }
}
