  "rules": [
    {
      "objectKey": "gift_card",
      "name": "Gift card initial value must be positive",
      "triggerKey": "before_save",
      "conditions": [
        {
          "field": "initial_value",
          "operator": "less_than_or_equal",
          "value": 0
        }
      ],
      "action": {
        "type": "validation",
        "message": "Gift card initial value must be positive"
      }
    },
    {
      "objectKey": "gift_card_activity",
      "name": "Gift card transaction amount must be positive",
      "triggerKey": "before_save",
      "conditions": [
        {
          "field": "amount",
          "operator": "less_than_or_equal",
          "value": 0
        }
      ],
      "action": {
        "type": "validation",
        "message": "Gift card transaction amount must be positive"
