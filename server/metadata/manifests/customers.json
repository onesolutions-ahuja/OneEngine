      "childObjectKey": "contact",
      "relationshipKey": "contacts",
      "relationshipType": "one_to_many",
      "childFieldApiName": "customer_id"
    },
    {
      "parentObjectKey": "customer",
      "childObjectKey": "address",
      "relationshipKey": "addresses",
      "relationshipType": "one_to_many",
      "childFieldApiName": "customer_id"
    }
  ],
  "listViews": [
    {
      "objectKey": "customer",
      "viewKey": "all",
      "label": "All Customers",
      "columns": [
        "name",
        "email",
        "phone",
        "loyalty_number",
        "active"
      ],
      "isDefault": true
    },
    {
      "objectKey": "contact",
      "viewKey": "all",
      "label": "All Contacts",
      "columns": [
        "name",
        "email",
        "phone",
        "job_title"
      ],
      "isDefault": true
    },
    {
      "objectKey": "address",
      "viewKey": "all",
      "label": "All Addresses",
      "columns": [
        "line_1",
        "city",
        "postcode",
        "address_type"
      ],
      "isDefault": true
    }
  ],
  "actions": [
    {
      "actionKey": "customer.add_contact",
      "objectKey": "customer",
      "label": "Add Contact",
      "description": "Create a related contact for this customer.",
      "handlerKey": "CREATE_RELATED_RECORD",
      "requiredPermission": "customer.edit",
      "config": {
        "relationshipKey": "contacts"
      }
    },
    {
      "actionKey": "customer.add_address",
      "objectKey": "customer",
      "label": "Add Address",
      "description": "Create a related address for this customer.",
      "handlerKey": "CREATE_RELATED_RECORD",
      "requiredPermission": "customer.edit",
      "config": {
        "relationshipKey": "addresses"
      }
    }
  ],
  "rules": [
    {
      "objectKey": "contact",
      "name": "Contact has a name",
      "triggerKey": "before_save",
      "conditions": [
        {
          "field": "name",
          "operator": "is_empty"
        }
      ],
      "action": {
        "type": "validation",
        "message": "Contact name is required"
      }
    },
    {
      "objectKey": "address",
      "name": "Address line 1 is required",
      "triggerKey": "before_save",
      "conditions": [
        {
          "field": "line_1",
          "operator": "is_empty"
        }
      ],
      "action": {
        "type": "validation",
        "message": "Address line 1 is required"
      }
    },
    {
      "objectKey": "customer",
      "name": "Customer name is required",
      "triggerKey": "before_save",
      "conditions": [
        {
          "field": "name",
          "operator": "is_empty"
        }
      ],
      "action": {
        "type": "validation",
        "message": "Customer name is required"
      }
    }
  ],
  "packageKey": "customers",
  "workflows": [
    {
      "name": "Register Customer",
      "triggerKey": "manual",
      "action": {
        "type": "workflow",
        "apiName": "CUSTOMER_REGISTER",
        "flowType": "AUTOLAUNCHED",
        "inputContract": {
          "name": {
            "type": "text",
            "required": true
          },
          "phone": {
            "type": "text"
          },
          "email": {
            "type": "text"
          }
        },
        "outputContract": {
          "customer": {
            "type": "record"
          }
        },
        "actions": [
          {
            "id": "create_customer",
            "label": "Create Customer",
            "apiName": "create_customer",
            "key": "CREATE_RECORD",
            "objectKey": "customer",
            "fieldValues": {
              "name": {
                "path": "variables.name"
              },
              "phone": {
                "path": "variables.phone"
              },
              "email": {
                "path": "variables.email"
              },
              "active": true
            }
          }
        ]
      }
    }
  ]
}
