    {
      "name": "Purchase Create",
      "key": "purchase_create",
      "apiName": "PURCHASE_CREATE",
      "inputContract": [
        {
          "apiName": "supplierId",
          "type": "string"
        },
        {
          "apiName": "amount",
          "type": "number"
        }
      ],
      "outputContract": [
        {
          "apiName": "purchaseId",
          "type": "string"
        }
      ],
      "action": {
        "apiName": "PURCHASE_CREATE",
        "actions": [
          {
            "id": "validate_purchase_total",
            "key": "FORMULA",
            "label": "Validate Purchase Total",
            "apiName": "validate_purchase_total",
            "expression": "amount > 0",
            "resultType": "boolean"
          },
          {
            "id": "check_purchase_status",
            "key": "CONDITION",
            "label": "Check Purchase Status",
            "apiName": "check_purchase_status",
            "outcomes": [
              {
                "id": "ok",
                "label": "Allowed",
                "condition": {
                  "match": "all",
                  "conditions": [
                    {
                      "field": "status",
                      "operator": "equals",
                      "value": "DRAFT"
                    }
                  ]
                },
                "branch": [
                  "create_purchase"
                ]
              },
              {
                "id": "fail",
                "label": "Blocked",
                "condition": {
                  "match": "all",
                  "conditions": [
                    {
                      "field": "status",
                      "operator": "not_equals",
                      "value": "DRAFT"
                    }
                  ]
                },
                "branch": [
                  "raise_purchase_error"
                ]
              }
            ],
            "defaultLabel": "Blocked",
            "defaultBranch": [
              "raise_purchase_error"
            ]
          },
          {
            "id": "create_purchase",
            "key": "CREATE_RECORD",
            "label": "Create Purchase",
