                  "step": 0.001,
                  "required": true,
                  "defaultValue": 1
                },
                {
                  "name": "unitCost",
                  "label": "Unit cost",
                  "type": "number",
                  "min": 0,
                  "step": 0.01,
                  "required": true,
                  "defaultValue": 0
                },
                {
                  "name": "batchNumber",
                  "label": "Batch",
                  "type": "text"
                },
                {
                  "name": "manufacturingDate",
                  "label": "MFG",
                  "type": "date"
                },
                {
                  "name": "expiryDate",
                  "label": "Expiry",
                  "type": "date"
                }
              ]
            },
