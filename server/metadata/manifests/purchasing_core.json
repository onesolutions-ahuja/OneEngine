              "type": "text"
            },
            {
              "name": "purchaseDate",
              "label": "Purchase date",
              "type": "date",
              "defaultValue": "today",
              "required": true
            },
            {
              "name": "notes",
              "label": "Notes",
              "type": "textarea"
            },
            {
              "name": "items",
              "label": "Product lines",
              "type": "collection",
              "minRows": 1,
              "defaultRows": 1,
              "fields": [
                {
                  "name": "productId",
