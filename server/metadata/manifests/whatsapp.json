{
  "connectors": [
    {
      "connectorKey": "whatsapp",
      "name": "whatsapp Connection",
      "description": "Metadata-driven connection for whatsapp.",
      "publisher": "OneSolutions",
      "authType": "bearer",
      "baseUrl": "https://graph.facebook.com/v21.0",
      "credentialsSchema": [
        {
          "key": "token",
          "type": "secret",
          "required": true,
          "label": "Meta access token"
        }
      ],
      "operations": [
        {
          "key": "send_message",
          "name": "Send WhatsApp Message",
          "method": "POST",
          "path": "/{{phoneNumberId}}/messages"
        }
      ],
      "timeoutMs": 15000,
      "retryPolicy": {
        "maxAttempts": 1,
        "backoffMs": 0
      },
      "required": true
    }
  ],
  "iconAssetKey": "whatsapp"
}
