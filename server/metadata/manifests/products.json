          "writable": true,
          "displayOrder": 6
        },
        {
          "apiName": "product_kind",
          "label": "Product Kind",
          "fieldType": "picklist",
          "sourceColumn": "product_kind",
          "writable": true,
          "options": [
            "standard",
            "variant",
            "bundle"
          ],
          "displayOrder": 7
        },
        {
          "apiName": "parent_product_id",
          "label": "Parent Product",
          "fieldType": "lookup",
          "sourceColumn": "parent_product_id",
          "writable": true,
          "config": {
            "relatedObjectKey": "product",
            "relationshipKey": "variants",
            "preventSelfReference": true
          },
          "displayOrder": 8
        },
        {
          "apiName": "variant_attributes",
          "label": "Variant Attributes",
          "fieldType": "json",
          "sourceColumn": "variant_attributes",
          "writable": true,
          "displayOrder": 9
