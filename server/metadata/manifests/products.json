          "displayOrder": 4
        },
        {
          "apiName": "age_restricted",
          "label": "Age Restricted",
          "fieldType": "boolean",
          "sourceColumn": "age_restricted",
          "writable": true,
          "displayOrder": 4
        },
        {
          "apiName": "stock_quantity",
          "label": "Stock Quantity",
