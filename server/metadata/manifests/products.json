          "sourceColumn": "created_at",
          "writable": false,
          "displayOrder": 11
        },
        {
          "apiName": "updated_at",
          "label": "Updated",
          "fieldType": "datetime",
          "sourceColumn": "updated_at",
          "writable": false,
          "displayOrder": 12
        }
      ],
      "config": {
        "flowWritesOnly": true
      }
    },
    {
      "objectKey": "category",
