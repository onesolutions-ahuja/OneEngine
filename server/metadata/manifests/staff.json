        },
        {
          "id": "invite_enabled",
          "label": "Email Registration Enabled",
          "apiName": "invite_enabled",
          "key": "CONDITION",
          "outcomes": [
            {
              "id": "yes",
              "label": "Enabled",
              "condition": {
                "match": "all",
