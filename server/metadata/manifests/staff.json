        "flowType": "AUTOLAUNCHED",
        "inputContract": [
          {
            "name": "userId",
            "label": "userId",
            "type": "text",
            "required": true
          },
          {
            "name": "now",
            "label": "now",
            "type": "text",
            "required": true
          }
        ],
        "outputContract": [
          {
            "name": "recordId",
            "label": "recordId",
