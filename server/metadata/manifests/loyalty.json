  "workflows": [
    {
      "name": "Adjust Loyalty",
      "key": "loyalty_adjust",
      "apiName": "LOYALTY_ADJUST",
      "inputContract": [
        {
          "apiName": "customerId",
          "type": "string"
        },
        {
          "apiName": "points",
          "type": "number"
        }
      ],
      "outputContract": [
        {
          "apiName": "adjustmentId",
          "type": "string"
        }
      ],
      "action": {
        "apiName": "LOYALTY_ADJUST",
        "actions": [
          {
            "id": "validate_loyalty",
            "key": "FORMULA",
            "label": "Validate Loyalty",
            "apiName": "validate_loyalty",
            "expression": "points >= 0",
            "resultType": "boolean"
          },
          {
            "id": "get_account",
            "key": "GET_RECORDS",
            "label": "Get Loyalty Account",
            "apiName": "get_account",
            "objectKey": "customer_loyalty_balance",
            "filters": [
              {
                "field": "customer_id",
                "operator": "equals",
                "value": {
                  "path": "variables.customerId"
                }
              }
            ],
            "limit": 1
          },
          {
            "id": "loyalty_ready",
            "key": "CONDITION",
            "label": "Loyalty Ready",
            "apiName": "loyalty_ready",
            "outcomes": [
              {
                "id": "ok",
                "label": "Allowed",
                "condition": {
                  "match": "all",
                  "conditions": [
                    {
                      "field": "customer_loyalty_balance.id",
                      "operator": "is_set",
                      "value": true
                    }
                  ]
                },
                "branch": [
                  "apply_loyalty_adjustment"
                ]
              },
              {
                "id": "fail",
                "label": "Blocked",
                "condition": {
                  "match": "all",
                  "conditions": [
                    {
                      "field": "customer_loyalty_balance.id",
                      "operator": "is_set",
                      "value": false
                    }
                  ]
                },
                "branch": [
                  "raise_loyalty_error"
                ]
              }
            ],
            "defaultLabel": "Blocked",
            "defaultBranch": [
              "raise_loyalty_error"
            ]
          },
          {
            "id": "update_balance",
            "key": "UPDATE_RECORD",
            "label": "Update Loyalty Balance",
            "apiName": "update_balance",
            "objectKey": "customer_loyalty_balance",
            "recordId": {
              "path": "steps.get_account.records[0].id"
            },
            "fieldValues": {
              "points": {
                "path": "steps.get_account.records[0].points + variables.points"
              }
            }
          },
          {
            "id": "apply_loyalty_adjustment",
