  "workflows": [
    {
      "name": "Adjust Loyalty",
      "triggerKey": "manual",
      "action": {
        "type": "workflow",
        "apiName": "LOYALTY_ADJUST",
        "flowType": "AUTOLAUNCHED",
        "inputContract": {
          "customerId": {
            "type": "text",
            "required": true
          },
          "points": {
            "type": "number",
            "required": true
          },
          "reason": {
            "type": "text",
            "required": true
          },
          "referenceId": {
            "type": "text"
          }
        },
        "outputContract": {
          "adjustment": {
            "type": "record"
          }
        },
        "actions": [
          {
            "id": "validate_loyalty_adjustment",
            "label": "Validate Loyalty Adjustment",
            "apiName": "validate_loyalty_adjustment",
            "key": "FORMULA",
            "resourceName": "loyaltyValid",
            "resultType": "boolean",
            "expression": "points != 0 && !ISBLANK(customerId) && !ISBLANK(reason)",
            "inputs": {
              "points": {
                "path": "variables.points"
              },
              "customerId": {
                "path": "variables.customerId"
              },
              "reason": {
                "path": "variables.reason"
              }
            }
          },
          {
            "id": "get_account",
            "label": "Get Loyalty Account",
            "apiName": "get_account",
            "key": "GET_RECORDS",
            "objectKey": "loyalty_account",
            "filters": [
              {
                "field": "customer_id",
                "operator": "equals",
                "value": {
                  "path": "variables.customerId"
                }
              }
            ],
            "limit": 1,
            "store": "first"
          },
          {
            "id": "loyalty_ready",
            "label": "Loyalty Adjustment Ready?",
            "apiName": "loyalty_ready",
            "key": "CONDITION",
            "outcomes": [
              {
                "id": "yes",
                "label": "Valid",
                "condition": {
                  "match": "all",
                  "conditions": [
                    {
                      "field": "variables.loyaltyValid",
                      "operator": "equals",
                      "value": true
                    },
                    {
                      "field": "steps.get_account.record.id",
                      "operator": "is_null",
                      "value": false
                    }
                  ]
                },
                "branch": [
                  "create_adjustment",
                  "create_activity",
                  "update_balance"
                ]
              }
            ],
            "defaultLabel": "Invalid Adjustment",
            "defaultBranch": [
              "loyalty_invalid"
            ]
          },
          {
            "id": "create_adjustment",
            "label": "Create Loyalty Adjustment",
            "apiName": "create_adjustment",
            "key": "CREATE_RECORD",
            "objectKey": "loyalty_adjustment",
            "fieldValues": {
              "customer_id": {
                "path": "variables.customerId"
              },
              "points": {
                "path": "variables.points"
              },
              "reason": {
                "path": "variables.reason"
              },
              "reference_id": {
                "path": "variables.referenceId"
              }
            }
          },
          {
            "id": "create_activity",
            "label": "Create Loyalty Activity",
            "apiName": "create_activity",
            "key": "CREATE_RECORD",
            "objectKey": "loyalty_activity",
            "fieldValues": {
              "customer_id": {
                "path": "variables.customerId"
              },
              "transaction_type": "ADJUSTMENT",
              "amount": {
                "path": "variables.points"
              },
              "reference_type": "loyalty_adjustment",
              "reference_id": {
                "path": "steps.create_adjustment.created.id"
              },
              "description": {
                "path": "variables.reason"
              }
            }
          },
          {
            "id": "update_balance",
            "label": "Update Loyalty Balance",
            "apiName": "update_balance",
            "key": "UPDATE_RECORD",
            "objectKey": "loyalty_account",
            "recordId": {
              "path": "steps.get_account.record.id"
            },
            "fieldValues": {
              "balance": {
                "path": "steps.create_activity.created.balance_after"
              }
            }
          },
          {
            "id": "loyalty_invalid",
            "label": "Loyalty Adjustment Rejected",
            "apiName": "loyalty_invalid",
            "key": "CUSTOM_ERROR",
            "errorMessage": "Loyalty adjustment requires an existing loyalty account, a non-zero points value, and a reason.",
            "errorLocation": "record"
          }
        ],
        "resources": [
          {
            "value": "variables.loyaltyValid",
            "apiName": "loyaltyValid",
            "label": "Loyalty Adjustment Valid",
            "type": "Variable",
            "dataType": "Boolean",
            "defaultValue": false,
            "isCollection": false,
            "availableInput": false,
            "availableOutput": false
          }
        ],
        "gptBuilder": true,
        "layout": {
          "mode": "AUTO"
