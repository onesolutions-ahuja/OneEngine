      "access": "execute"
    },
    {
      "key": "configure",
      "permission": "settings.manage",
      "access": "write"
    }
  ],
  "actions": [
    {
      "actionKey": "loyalty.adjust",
      "objectKey": "loyalty_account",
      "label": "Adjust Loyalty",
      "description": "Run the editable loyalty adjustment Flow.",
      "handlerKey": "RUN_SUBFLOW",
      "requiredPermission": "loyalty.adjust",
      "config": {
        "subflowApiName": "LOYALTY_ADJUST"
      }
    }
  ],
  "listViews": [
    {
      "objectKey": "loyalty_account",
      "viewKey": "all",
      "label": "Customer Loyalty",
      "columns": [
        "customer_id",
        "balance",
        "updated_at"
      ],
      "isDefault": true
    },
    {
      "objectKey": "loyalty_activity",
      "viewKey": "all",
      "label": "Loyalty Activity",
      "columns": [
        "customer_id",
        "transaction_type",
        "amount",
        "reference_type",
        "created_at"
      ],
      "isDefault": true
    }
  ],
  "references": [
    {
      "packageKey": "retail_pos",
      "objectKey": "sale",
      "purpose": "Sale reference for earning, redemption and reversal activity"
    },
    {
      "packageKey": "retail_pos",
      "objectKey": "payment",
      "purpose": "Loyalty redemption remains a Payment Core tender"
    }
  ],
  "packageKey": "loyalty",
  "buttons": [
    {
      "buttonKey": "loyalty_adjust",
      "objectKey": "loyalty_account",
      "label": "Adjust Loyalty",
      "actionKey": "loyalty.adjust",
      "requiredPermission": "loyalty.adjust",
      "variant": "primary"
    }
  ],
  "workflows": [
    {
      "name": "Adjust Loyalty",
      "triggerKey": "manual",
      "action": {
        "type": "workflow",
        "apiName": "LOYALTY_ADJUST",
        "flowType": "AUTOLAUNCHED",
        "inputContract": {
          "customerId": {
            "type": "text",
            "required": true
          },
          "points": {
            "type": "number",
            "required": true
          },
          "reason": {
            "type": "text",
            "required": true
          },
          "referenceId": {
            "type": "text"
          }
        },
        "outputContract": {
          "adjustment": {
            "type": "record"
          }
        },
        "actions": [
          {
            "id": "get_account",
            "label": "Get Loyalty Account",
            "apiName": "get_account",
            "key": "GET_RECORDS",
            "objectKey": "loyalty_account",
            "filters": [
              {
                "field": "customer_id",
                "operator": "equals",
                "value": {
                  "path": "variables.customerId"
                }
              }
            ],
            "limit": 1,
            "store": "first"
          },
          {
            "id": "create_adjustment",
            "label": "Create Loyalty Adjustment",
            "apiName": "create_adjustment",
            "key": "CREATE_RECORD",
            "objectKey": "loyalty_adjustment",
            "fieldValues": {
              "customer_id": {
                "path": "variables.customerId"
              },
              "points": {
                "path": "variables.points"
              },
              "reason": {
                "path": "variables.reason"
              },
              "reference_id": {
                "path": "variables.referenceId"
              }
            }
          },
          {
            "id": "create_activity",
            "label": "Create Loyalty Activity",
            "apiName": "create_activity",
            "key": "CREATE_RECORD",
            "objectKey": "loyalty_activity",
            "fieldValues": {
              "customer_id": {
                "path": "variables.customerId"
              },
              "transaction_type": "ADJUSTMENT",
              "amount": {
                "path": "variables.points"
              },
              "reference_type": "loyalty_adjustment",
              "reference_id": {
                "path": "steps.create_adjustment.created.id"
              },
              "description": {
                "path": "variables.reason"
              }
            }
          },
          {
            "id": "update_balance",
            "label": "Update Loyalty Balance",
            "apiName": "update_balance",
            "key": "UPDATE_RECORD",
            "objectKey": "loyalty_account",
            "recordId": {
              "path": "steps.get_account.record.id"
            },
            "fieldValues": {
              "balance": {
                "path": "steps.create_activity.created.balance_after"
              }
            }
          }
        ]
      }
    }
  ]
}
