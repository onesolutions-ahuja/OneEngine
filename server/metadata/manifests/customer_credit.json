  "listViews": [
    {
      "objectKey": "customer_credit_account",
      "viewKey": "all",
      "label": "All Credit Accounts",
      "columns": [
        "credit_enabled",
        "credit_limit"
      ],
      "isDefault": true
    },
    {
      "objectKey": "customer_credit_account",
      "viewKey": "active",
      "label": "Active",
      "filters": {
        "credit_enabled": true
      }
    },
    {
      "objectKey": "customer_credit_account",
      "viewKey": "disabled",
      "label": "Credit Disabled",
      "filters": {
        "credit_enabled": false
      }
    },
    {
      "objectKey": "customer_ledger",
      "viewKey": "all",
      "label": "Credit Ledger Activity",
      "columns": [
        "customer_id",
        "transaction_type",
        "amount",
        "created_at"
      ],
      "isDefault": true
    }
  ],
  "rules": [
    {
      "objectKey": "customer_credit_account",
      "name": "Credit limit cannot be negative",
      "triggerKey": "before_save",
      "conditions": [
        {
          "field": "credit_limit",
          "operator": "less_than",
          "value": 0
        }
      ],
      "action": {
        "type": "validation",
        "message": "Credit limit cannot be negative"
      }
    },
    {
      "objectKey": "customer_credit_account",
      "name": "Credit enabled requires a limit",
      "triggerKey": "before_save",
      "conditions": [
        {
          "field": "credit_enabled",
          "operator": "equals",
          "value": true
        },
        {
          "field": "credit_limit",
          "operator": "is_empty"
        }
      ],
      "action": {
        "type": "validation",
        "message": "A credit limit is required when credit is enabled"
      }
    },
    {
      "objectKey": "customer_ledger",
      "name": "Credit payment received notification",
      "triggerKey": "after_save",
      "conditions": [
        {
          "field": "transaction_type",
          "operator": "equals",
          "value": "payment"
        }
      ],
      "action": {
        "type": "send_in_app_notification",
        "title": "Credit payment received"
      }
    },
    {
      "objectKey": "customer_ledger",
      "name": "Credit ledger amount must be positive",
      "triggerKey": "before_save",
      "conditions": [
        {
          "field": "amount",
          "operator": "less_than_or_equal",
          "value": 0
        }
      ],
      "action": {
        "type": "validation",
        "message": "Credit ledger amount must be positive"
      }
    }
  ],
  "packageKey": "customer_credit",
  "workflows": [
    {
      "name": "Post Customer Credit Entry",
      "triggerKey": "manual",
      "action": {
        "type": "workflow",
        "apiName": "CUSTOMER_CREDIT_POST",
        "flowType": "AUTOLAUNCHED",
        "inputContract": {
          "customerId": {
            "type": "text",
            "required": true
          },
          "storeId": {
            "type": "text"
          },
          "transactionType": {
            "type": "text",
            "required": true
          },
          "amount": {
            "type": "number",
            "required": true
          },
          "referenceType": {
            "type": "text"
          },
          "referenceId": {
            "type": "text"
          },
          "description": {
            "type": "text"
          },
          "idempotencyKey": {
            "type": "text",
            "required": true
          }
        },
        "outputContract": {
          "entry": {
            "type": "record"
          }
        },
        "actions": [
          {
            "id": "validate_credit_entry",
            "label": "Validate Credit Entry",
            "apiName": "validate_credit_entry",
            "key": "FORMULA",
            "resourceName": "creditEntryValid",
            "resultType": "boolean",
            "expression": "amount > 0 && !ISBLANK(customerId) && !ISBLANK(transactionType) && !ISBLANK(idempotencyKey)",
            "inputs": {
              "amount": {
                "path": "variables.amount"
              },
              "customerId": {
                "path": "variables.customerId"
              },
              "transactionType": {
                "path": "variables.transactionType"
              },
              "idempotencyKey": {
                "path": "variables.idempotencyKey"
              }
            }
          },
          {
            "id": "find_customer",
            "label": "Find Customer",
            "apiName": "find_customer",
            "key": "GET_RECORDS",
            "objectKey": "customer",
            "filters": [
              {
                "field": "id",
                "operator": "equals",
                "value": {
                  "path": "variables.customerId"
                }
              }
            ],
            "match": "all",
            "limit": 1,
            "store": "first"
          },
          {
            "id": "find_existing_credit_entry",
            "label": "Find Existing Credit Entry",
            "apiName": "find_existing_credit_entry",
            "key": "GET_RECORDS",
            "objectKey": "customer_ledger",
            "filters": [
              {
                "field": "idempotency_key",
                "operator": "equals",
                "value": {
                  "path": "variables.idempotencyKey"
                }
              }
            ],
            "match": "all",
            "limit": 1,
            "store": "first"
          },
          {
            "id": "credit_entry_ready",
            "label": "Credit Entry Ready?",
            "apiName": "credit_entry_ready",
            "key": "CONDITION",
            "outcomes": [
              {
                "id": "yes",
                "label": "Valid",
                "condition": {
                  "match": "all",
                  "conditions": [
                    {
                      "field": "variables.creditEntryValid",
                      "operator": "equals",
                      "value": true
                    },
                    {
                      "field": "steps.find_customer.record.id",
                      "operator": "is_null",
                      "value": false
                    },
                    {
                      "field": "steps.find_existing_credit_entry.record.id",
                      "operator": "is_null",
                      "value": true
                    }
                  ]
                },
                "branch": [
                  "create_entry"
                ]
              }
            ],
            "defaultLabel": "Invalid or Duplicate",
            "defaultBranch": [
              "credit_entry_invalid"
            ]
          },
          {
            "id": "create_entry",
            "label": "Create Customer Credit Ledger Entry",
            "apiName": "create_entry",
            "key": "CREATE_RECORD",
            "objectKey": "customer_ledger",
            "idempotency": {
              "key": {
                "path": "variables.idempotencyKey"
              },
              "matchFields": [
                "idempotency_key"
              ],
              "onMatch": "skip"
            },
            "fieldValues": {
              "customer_id": {
                "path": "variables.customerId"
              },
              "store_id": {
                "path": "variables.storeId"
              },
              "transaction_type": {
                "path": "variables.transactionType"
              },
              "amount": {
                "path": "variables.amount"
              },
              "reference_type": {
                "path": "variables.referenceType"
              },
              "reference_id": {
                "path": "variables.referenceId"
              },
              "description": {
                "path": "variables.description"
              },
              "idempotency_key": {
                "path": "variables.idempotencyKey"
              }
            }
          },
          {
            "id": "credit_entry_invalid",
            "label": "Customer Credit Entry Rejected",
            "apiName": "credit_entry_invalid",
            "key": "CUSTOM_ERROR",
            "errorMessage": "Credit entry is invalid, the customer does not exist, or the idempotency key was already used.",
            "errorLocation": "record"
          }
        ],
