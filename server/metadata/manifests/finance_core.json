  "workflows": [
    {
      "objectKey": "supplier",
      "name": "Supplier Invoice Create",
      "triggerKey": "manual",
      "active": true,
      "lifecycleStatus": "ACTIVE",
      "actions": [
        {
          "id": "create_invoice",
          "label": "Create Supplier Invoice",
          "key": "CREATE_RECORD",
          "objectKey": "supplier_invoice",
          "fieldValues": {
            "supplier_id": {
              "path": "record.id"
            },
            "invoice_number": {
              "path": "record.invoiceNumber"
            },
            "invoice_date": {
              "path": "record.invoiceDate"
            },
            "due_date": {
              "path": "record.dueDate"
            },
            "subtotal": {
              "path": "record.subtotal"
            },
            "tax": {
              "path": "record.tax"
            },
            "total": {
              "path": "record.total"
            },
            "purchase_id": {
              "path": "record.purchaseId"
            },
            "notes": {
              "path": "record.notes"
            },
            "status": "OPEN"
          }
        },
        {
          "id": "post_invoice_ledger",
          "label": "Post Supplier Invoice Ledger",
          "key": "CREATE_RECORD",
          "objectKey": "supplier_ledger",
          "fieldValues": {
            "supplier_id": {
              "path": "record.id"
            },
            "entry_type": "INVOICE",
            "reference_type": "supplier_invoice",
            "reference_id": {
              "path": "steps.create_invoice.created.id"
            },
            "reference": {
              "path": "record.invoiceNumber"
            },
            "amount": {
              "path": "record.total"
            },
            "debit": true,
            "description": {
              "path": "record.notes"
            }
          }
        }
      ],
      "inputContract": [
        {
          "name": "supplierId",
          "type": "id",
          "required": true
        },
        {
          "name": "invoiceNumber",
          "type": "string",
          "required": true
        },
        {
          "name": "invoiceDate",
          "type": "date",
          "required": true
        },
        {
          "name": "dueDate",
          "type": "date"
        },
        {
          "name": "subtotal",
          "type": "number",
          "required": true
        },
        {
          "name": "tax",
          "type": "number",
          "required": true
        },
        {
          "name": "total",
          "type": "number",
          "required": true
        },
        {
          "name": "purchaseId",
          "type": "id"
        },
        {
          "name": "notes",
          "type": "string"
        }
      ],
      "outputContract": [
        {
          "name": "invoice",
          "type": "record",
          "source": "steps.create_invoice.created"
        }
      ],
      "apiName": "SUPPLIER_INVOICE_CREATE",
      "flowType": "AUTOLAUNCHED"
    },
    {
      "objectKey": "supplier",
      "name": "Supplier Payment Execute",
      "triggerKey": "manual",
      "active": true,
      "lifecycleStatus": "ACTIVE",
      "actions": [
        {
          "id": "create_payment",
          "label": "Create Supplier Payment",
          "key": "CREATE_RECORD",
          "objectKey": "supplier_payment",
          "checkMatchingRecords": true,
          "matchAction": "skip",
          "matchConditions": [
            {
              "field": "idempotency_key",
              "operator": "equals",
              "value": {
                "path": "record.idempotencyKey"
              }
            }
          ],
          "fieldValues": {
            "supplier_id": {
              "path": "record.id"
            },
            "amount": {
              "path": "record.amount"
            },
            "payment_date": {
              "path": "record.paymentDate"
            },
            "payment_method": {
              "path": "record.paymentMethod"
            },
            "reference": {
              "path": "record.reference"
            },
            "status": "COMPLETED",
            "idempotency_key": {
              "path": "record.idempotencyKey"
            }
          }
        },
        {
          "id": "create_allocation",
          "label": "Allocate Payment To Invoice",
          "key": "CREATE_RECORD",
          "objectKey": "supplier_payment_allocation",
          "fieldValues": {
            "payment_id": {
              "path": "steps.create_payment.created.id"
            },
            "invoice_id": {
              "path": "record.invoiceId"
            },
            "amount": {
              "path": "record.amount"
            }
          }
        },
        {
          "id": "post_payment_ledger",
          "label": "Post Supplier Payment Ledger",
          "key": "CREATE_RECORD",
          "objectKey": "supplier_ledger",
          "checkMatchingRecords": true,
          "matchAction": "skip",
          "matchConditions": [
            {
              "field": "idempotency_key",
              "operator": "equals",
              "value": {
                "path": "record.idempotencyKey"
              }
            }
          ],
          "fieldValues": {
            "supplier_id": {
              "path": "record.id"
            },
            "entry_type": "PAYMENT",
            "reference_type": "supplier_payment",
            "reference_id": {
              "path": "steps.create_payment.created.id"
            },
            "reference": {
              "path": "record.reference"
            },
            "amount": {
              "path": "record.amount"
            },
            "debit": false,
            "idempotency_key": {
              "path": "record.idempotencyKey"
            }
          }
        }
      ],
      "inputContract": [
        {
          "name": "supplierId",
          "type": "id",
          "required": true
        },
        {
          "name": "amount",
          "type": "number",
          "required": true
        },
        {
          "name": "paymentDate",
          "type": "date"
        },
        {
